node_modules
dist
.turbo
*.tsbuildinfo
.npm-cache/
.worktrees/
# Local agent / review scratch space. Never treat as project source of truth.
.superpowers/

# Local audit and build leftovers.
.audit-*/
*.log

# Real E2E runs can produce many failed/partial attempts and SQLite runtime
# sidecars. Keep curated evidence only by explicitly force-adding it.
evidence/rain-real-e2e-*/
evidence/whisper-direct-diagnostic/
evidence/**/rain-e2e.db
evidence/**/rain-e2e.db-shm
evidence/**/rain-e2e.db-wal

# Visual-evidence **diagnostic** dumps (RAIN_VISUAL_DIAGNOSTIC=1) are diagnostic only:
# they are not §3.4 evidence, must never be committed, and must not be mistaken for
# collected evidence by a reviewer reading the package. They live inside a package
# directory (evidence/<package>/diagnostic/) so that the artifact upload still carries
# them, which is exactly why this rule has to exist.
evidence/**/diagnostic/
