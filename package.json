{
  "name": "rain",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "harness:control": "node scripts/control-plane-validator.mjs",
    "harness:check": "npm run harness:control && npm test && npm run build && npm run test:rust",
    "test:live:llm": "set RAIN_LIVE_LLM_REQUIRED=1&& vitest run src/__tests__/live-qwen.test.ts",
    "test:live:qwen": "npm run test:live:llm",
    "e2e:runtime-settings": "powershell.exe -ExecutionPolicy Bypass -File scripts/run-runtime-settings-e2e.ps1",
    "e2e:real": "powershell.exe -ExecutionPolicy Bypass -File scripts/run-real-e2e.ps1",
    "validate:evidence": "powershell.exe -ExecutionPolicy Bypass -File scripts/validate-evidence.ps1"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3",
    "zustand": "^4.5.7"
  }
}
