{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rain",
  "version": "0.1.0",
  "identifier": "com.rain.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Rain",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": []
    }
  },
  "bundle": {
    "resources": {
      "../test-fixtures/asr-capability.mp4": "asr-capability/sample.mp4"
    }
  }
}
